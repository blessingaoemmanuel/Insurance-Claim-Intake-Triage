    {
      "parameters": {
        "description": "Takes a JSON string with description, amountClaimed, incidentDate, policyStartDate, coverageLimit, priorClaims, today. Returns JSON with a list of red-flag signals found.",
        "jsCode": "let data = {};\ntry { data = JSON.parse(query); } catch (e) { return JSON.stringify({ error: 'Pass a valid JSON string', signals: [] }); }\nconst signals = [];\nconst today = data.today ? new Date(data.today) : new Date();\nconst start = data.policyStartDate ? new Date(data.policyStartDate) : null;\nconst incident = data.incidentDate ? new Date(data.incidentDate) : null;\nconst amount = Number(data.amountClaimed || 0);\nconst limit = Number(data.coverageLimit || 0);\nconst prior = Number(data.priorClaims || 0);\nconst text = String(data.description || '').toLowerCase();\nconst day = 86400000;\nif (start && !isNaN(start)) {\n  const daysSinceStart = Math.floor((today - start) / day);\n  if (daysSinceStart <= 30) signals.push('claim filed ' + daysSinceStart + ' days after policy start');\n  if (incident && !isNaN(incident) && Math.floor((incident - start) / day) <= 14) signals.push('incident within 14 days of policy start');\n}\nif (limit > 0 && amount >= 0.8 * limit) signals.push('amount is ' + Math.round(100 * amount / limit) + '% of coverage limit');\nif (limit > 0 && amount > limit) signals.push('amount exceeds coverage limit');\nif (prior >= 2) signals.push(prior + ' prior claims on record');\nconst pressure = ['urgent', 'immediately', 'asap', 'cash', 'today only', 'pay me now', 'no time'];\nconst hits = pressure.filter(w => text.includes(w));\nif (hits.length) signals.push('pressure language: ' + hits.join(', '));\nconst severe = ['total loss', 'stolen', 'theft', 'write off', 'written off'];\nif (severe.some(w => text.includes(w))) signals.push('high-severity loss type');\nif (text.length < 40) signals.push('very thin description');\nreturn JSON.stringify({ signalCount: signals.length, signals });"
      },
      "id": "c657ec5d-4bcb-4130-b4e6-9c2e8987408e",
      "name": "red_flag_check",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        -1120,
        80
      ]
